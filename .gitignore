# ─── Python build / packaging ────────────────────────────────────────────
dist/
build/
*.egg-info/
.pypirc

# ─── Virtual-envs ────────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Byte-code & cache ───────────────────────────────────────────────────
__pycache__/

# ─── IDE / Editor junk ───────────────────────────────────────────────────
.idea/
.vscode/

# ─── Project-specific large / auxiliary dirs (keep out of wheels) ────────
Bridge_*_Work_Dir/
Bridge_*_extract_*/
NGA_PEER_EQ_DB/
OpenSees_Windows/

# ─── Local data, results and models (not tracked) ────────────────────────
/data/
/PyPBEE_Work_Dir/
# In scripts/, track only the examples folder
/scripts/*
!/scripts/examples/

# ─── vendors ──────────────────────
vendor/**/*.exe

# ─── docx ──────────────────────
*.docx